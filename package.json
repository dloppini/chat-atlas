{
  "name": "lpx-conversation-board",
  "displayName": "Chat Atlas by LPX",
  "description": "A local conversation organizer with project filters, topic boards, workflow status, and a timeline.",
  "version": "0.1.58",
  "publisher": "lpx",
  "author": {
    "name": "LPX"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dloppini/chat-atlas.git"
  },
  "homepage": "https://github.com/dloppini/chat-atlas/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/dloppini/chat-atlas/issues"
  },
  "keywords": [
    "conversation-organizer",
    "project-board",
    "workflow",
    "timeline"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:chatAtlas.open",
    "onWebviewPanel:chatAtlas.board",
    "onUri",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "chatAtlas.selectProject",
        "title": "Chat Atlas: Select Project"
      },
      {
        "command": "chatAtlas.findChatsForFile",
        "title": "Chat Atlas: Find Chats for This File"
      },
      {
        "command": "chatAtlas.open",
        "title": "Chat Atlas: Open Board",
        "icon": "$(layout)"
      },
      {
        "command": "chatAtlas.openSettings",
        "title": "Chat Atlas: Open Settings"
      },
      {
        "command": "chatAtlas.refresh",
        "title": "Chat Atlas: Refresh Conversations"
      },
      {
        "command": "chatAtlas.enableExplorerMenu",
        "title": "Chat Atlas: Enable Windows Explorer Project Menu",
        "enablement": "isWindows"
      },
      {
        "command": "chatAtlas.disableExplorerMenu",
        "title": "Chat Atlas: Remove Windows Explorer Project Menu",
        "enablement": "isWindows"
      },
      {
        "command": "chatAtlas.registerMcp",
        "title": "Chat Atlas: Register MCP Server with Agents"
      },
      {
        "command": "chatAtlas.copyMcpSetup",
        "title": "Chat Atlas: Copy MCP Server Setup"
      },
      {
        "command": "chatAtlas.newChat",
        "title": "Chat Atlas: New Chat in Selected Project"
      },
      {
        "command": "chatAtlas.changeNewChatShortcut",
        "title": "Chat Atlas: Change New Chat Shortcut"
      },
      {
        "command": "chatAtlas.refreshFiles",
        "title": "Chat Atlas: Refresh Files",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "chatAtlas.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "chatAtlas.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'chatAtlas.board'"
      }
    ],
    "configuration": {
      "title": "Chat Atlas",
      "properties": {
        "chatAtlas.theme": {
          "type": "string",
          "enum": [
            "system",
            "pearl",
            "dark"
          ],
          "enumItemLabels": [
            "VS Code theme",
            "Pearl",
            "Dark"
          ],
          "default": "system",
          "scope": "application",
          "description": "Color theme for the Chat Atlas board."
        },
        "chatAtlas.codexHome": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Codex data folder. Empty uses CODEX_HOME or ~/.codex."
        },
        "chatAtlas.claudeHome": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Claude Code data folder. Empty uses CLAUDE_CONFIG_DIR or ~/.claude."
        },
        "chatAtlas.maxSessions": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "maximum": 10000,
          "description": "Maximum recent local conversations to index per provider."
        },
        "chatAtlas.refreshSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 10,
          "maximum": 300,
          "description": "Refresh interval while the board is open."
        },
        "chatAtlas.highlightActiveFiles": {
          "type": "boolean",
          "default": false,
          "description": "Highlight the most recently reported files of running Claude and Codex chats in Explorer and Chat Atlas Files."
        },
        "chatAtlas.runningTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 1440,
          "description": "Hide the running indicator after this many minutes without task activity. Increase it for long tools or builds. Completion and interruption records stop the indicator immediately."
        },
        "chatAtlas.notifications": {
          "type": "string",
          "enum": [
            "off",
            "questions",
            "all"
          ],
          "default": "questions",
          "scope": "application",
          "enumItemLabels": [
            "Off",
            "Questions only",
            "Questions and finished tasks"
          ],
          "description": "Show a VS Code notification with an Open chat action when a Codex or Claude Code chat asks you a question, or also when a running task finishes. Detected from local transcripts; permission prompts are not recorded there."
        },
        "chatAtlas.checkBehindMain": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Fetch each linked project's remote (origin, or its only remote) at most every 10 minutes while Chat Atlas refreshes, and notify when the current branch is behind the remote main branch. Fetching only updates remote-tracking branches; your working files and branches are not changed."
        },
        "chatAtlas.claudeTileAction": {
          "type": "string",
          "enum": [
            "chatWindow",
            "terminal"
          ],
          "default": "chatWindow",
          "scope": "application",
          "markdownDescription": "Where a Claude conversation opens when you select its title, and where new Claude chats and handoffs start.\n\nStart a new chat in the selected project with `Ctrl+N` (macOS: `Cmd+N`) while the board is focused. [Review or change the shortcut](command:chatAtlas.changeNewChatShortcut)."
        },
        "chatAtlas.modelPricing": {
          "type": "object",
          "scope": "application",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              }
            }
          },
          "markdownDescription": "USD per million tokens by model ID, used for the estimated API-equivalent cost in **Usage**. A key matches the longest model-ID prefix, so `claude-opus-5-5` also covers dated snapshots. Models without an entry show no cost. Subscription plans (Claude Max, ChatGPT) are not billed per token; the estimate shows what the same work would cost on the API.",
          "default": {
            "claude-fable-5-2": {
              "input": 8,
              "output": 40,
              "cacheWrite": 10,
              "cacheRead": 0.2
            },
            "claude-fable-5-1": {
              "input": 10,
              "output": 50,
              "cacheWrite": 12.5,
              "cacheRead": 1.0
            },
            "claude-fable-5": {
              "input": 10,
              "output": 50,
              "cacheWrite": 12.5,
              "cacheRead": 1.0
            },
            "claude-opus-5-5": {
              "input": 4,
              "output": 20,
              "cacheWrite": 5,
              "cacheRead": 0.2
            },
            "claude-opus-5": {
              "input": 5,
              "output": 25,
              "cacheWrite": 6.25,
              "cacheRead": 0.5
            },
            "claude-opus-4-8": {
              "input": 5,
              "output": 25,
              "cacheWrite": 6.25,
              "cacheRead": 0.5
            },
            "claude-opus-4-7": {
              "input": 5,
              "output": 25,
              "cacheWrite": 6.25,
              "cacheRead": 0.5
            },
            "claude-opus-4-6": {
              "input": 5,
              "output": 25,
              "cacheWrite": 6.25,
              "cacheRead": 0.5
            },
            "claude-opus-4-5": {
              "input": 5,
              "output": 25,
              "cacheWrite": 6.25,
              "cacheRead": 0.5
            },
            "claude-sonnet-5-5": {
              "input": 2,
              "output": 10,
              "cacheWrite": 2.5,
              "cacheRead": 0.1
            },
            "claude-sonnet-5": {
              "input": 2,
              "output": 10,
              "cacheWrite": 2.5,
              "cacheRead": 0.2
            },
            "claude-sonnet-4-6": {
              "input": 3,
              "output": 15,
              "cacheWrite": 3.75,
              "cacheRead": 0.3
            },
            "claude-sonnet-4-5": {
              "input": 3,
              "output": 15,
              "cacheWrite": 3.75,
              "cacheRead": 0.3
            },
            "claude-haiku-5-5": {
              "input": 0.1,
              "output": 0.5,
              "cacheWrite": 0.125,
              "cacheRead": 0.01
            },
            "claude-haiku-4-5": {
              "input": 1,
              "output": 5,
              "cacheWrite": 1.25,
              "cacheRead": 0.1
            }
          }
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "chatAtlas.files",
          "name": "Chat Atlas Files",
          "when": "chatAtlas.browsingFiles"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "chatAtlas.findChatsForFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "chatAtlas.findChatsForFile",
          "when": "view == chatAtlas.files && viewItem == atlasFile",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "chatAtlas.refreshFiles",
          "when": "view == chatAtlas.files",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "chatAtlas.refreshFiles",
          "when": "chatAtlas.browsingFiles"
        },
        {
          "command": "chatAtlas.newChat",
          "when": "activeWebviewPanelId == 'chatAtlas.board'"
        },
        {
          "command": "chatAtlas.enableExplorerMenu",
          "when": "isWindows"
        },
        {
          "command": "chatAtlas.disableExplorerMenu",
          "when": "isWindows"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/engineering.js && node --check src/engineering-graph.js && node --check src/mcp.js && node --check src/git.js && node --check src/core.js && node --check src/claude-tabs.js && node --check src/providers.js && node --check src/codex-chat.js && node --check media/board.js && node --check media/projects.js && node --check scripts/preview.js && node --check scripts/package.js",
    "package": "node scripts/package.js",
    "preview": "node scripts/preview.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
